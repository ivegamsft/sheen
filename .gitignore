# === basecoat-sheen .gitignore ===
# Tailored to repo content: Markdown/YAML specs, PowerShell/Bash/TS/Python
# scripts, JSON tokens & metadata, mkdocs docs, and vendored basecoat.

# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
*.local
.sheen.yml            # consumer config is per-repo; only the .example is tracked
!.sheen.yml.example
*.key
*.pem
secrets.*

# --- Node / TypeScript (scripts, token build) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
*.tsbuildinfo
.eslintcache

# --- Generated design-token build output ---
tokens/**/build/
tokens/**/dist/
tokens/**/*.generated.*

# --- Python (scripts) ---
__pycache__/
*.py[cod]
.venv/
venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docs site (mkdocs) ---
site/

# --- Logs / temp ---
*.log
*.tmp
*.bak
tmp/
.cache/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / IDEs ---
.idea/
*.swp
*.swo
# Keep shared VS Code settings, ignore local ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
