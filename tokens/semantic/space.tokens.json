{
  "$description": "Semantic spacing tokens — role aliases into the core space scale. Use these names in component implementations, never raw core values (spec 01 §3.2).",
  "space": {
    "component": {
      "padding-xs":  { "$type": "dimension", "$value": "{space.1}", "$description": "Extra-small inset (icon-only button, badge)" },
      "padding-sm":  { "$type": "dimension", "$value": "{space.2}", "$description": "Small inset (compact button, chip)" },
      "padding-md":  { "$type": "dimension", "$value": "{space.4}", "$description": "Default component padding" },
      "padding-lg":  { "$type": "dimension", "$value": "{space.6}", "$description": "Large inset (card header, dialog padding)" },
      "padding-xl":  { "$type": "dimension", "$value": "{space.8}", "$description": "Extra-large inset (hero, marketing section)" },
      "gap-xs":      { "$type": "dimension", "$value": "{space.1}", "$description": "Tight gap between inline elements" },
      "gap-sm":      { "$type": "dimension", "$value": "{space.2}", "$description": "Small gap (icon + label, radio + text)" },
      "gap-md":      { "$type": "dimension", "$value": "{space.4}", "$description": "Default gap (form field stack, list items)" },
      "gap-lg":      { "$type": "dimension", "$value": "{space.6}", "$description": "Generous gap (card grid, section spacing)" }
    },
    "layout": {
      "section-gap":  { "$type": "dimension", "$value": "{space.12}", "$description": "Vertical gap between page sections" },
      "page-margin":  { "$type": "dimension", "$value": "{space.16}", "$description": "Horizontal page gutter" },
      "sidebar-width":{ "$type": "dimension", "$value": "{space.24}", "$description": "Reference sidebar gutter width" }
    }
  }
}
