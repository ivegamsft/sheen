{
  "$description": "Semantic colour tokens — alias/role tokens. Reference core only. Convey meaning not raw value. Themes override $value; keys MUST stay stable (spec 01 s3.2).",
  "color": {
    "background":       { "$type": "color", "$value": "{color.neutral.5}",    "$description": "Page/canvas background" },
    "foreground":       { "$type": "color", "$value": "{color.neutral.85}",   "$description": "Default text colour" },
    "muted":            { "$type": "color", "$value": "{color.neutral.50}",   "$description": "Secondary/muted text" },
    "surface":          { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Card / panel surface" },
    "surface-raised":   { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Elevated card surface" },
    "border":           { "$type": "color", "$value": "{color.neutral.20}",   "$description": "Default border / divider" },
    "border-muted":     { "$type": "color", "$value": "{color.neutral.10}",   "$description": "Subtle border" },
    "focus-ring":       { "$type": "color", "$value": "{color.blue.50}",      "$description": "Keyboard focus indicator" },
    "primary":          { "$type": "color", "$value": "{color.blue.50}",      "$description": "Primary action / brand colour" },
    "on-primary":       { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Text/icon on primary background" },
    "primary-hover":    { "$type": "color", "$value": "{color.blue.60}",      "$description": "Primary on hover" },
    "primary-pressed":  { "$type": "color", "$value": "{color.blue.70}",      "$description": "Primary on press" },
    "primary-selected": { "$type": "color", "$value": "{color.blue.60}",      "$description": "Primary selected state" },
    "primary-disabled": { "$type": "color", "$value": "{color.neutral.20}",   "$description": "Primary disabled state" },
    "primary-focus":    { "$type": "color", "$value": "{color.blue.50}",      "$description": "Primary keyboard focus state" },
    "secondary":        { "$type": "color", "$value": "{color.neutral.10}",   "$description": "Secondary action background" },
    "on-secondary":     { "$type": "color", "$value": "{color.neutral.85}",   "$description": "Text/icon on secondary background" },
    "success":          { "$type": "color", "$value": "{color.green.50}",     "$description": "Success/positive state" },
    "on-success":       { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Text/icon on success background" },
    "success-subtle":   { "$type": "color", "$value": "{color.green.0}",      "$description": "Subtle success background tint" },
    "warning":          { "$type": "color", "$value": "{color.orange.50}",    "$description": "Warning/caution state" },
    "on-warning":       { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Text/icon on warning background" },
    "warning-subtle":   { "$type": "color", "$value": "{color.orange.0}",     "$description": "Subtle warning background tint" },
    "error":            { "$type": "color", "$value": "{color.red.50}",       "$description": "Error/danger state" },
    "on-error":         { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Text/icon on error background" },
    "error-subtle":     { "$type": "color", "$value": "{color.red.0}",        "$description": "Subtle error background tint" },
    "accent":           { "$type": "color", "$value": "{color.purple.50}",    "$description": "Accent / highlight colour" },
    "on-accent":        { "$type": "color", "$value": "{color.neutral.0}",    "$description": "Text/icon on accent background" },
    "link":             { "$type": "color", "$value": "{color.blue.50}",      "$description": "Hyperlink colour" },
    "link-hover":       { "$type": "color", "$value": "{color.blue.60}",      "$description": "Hyperlink on hover" },
    "link-visited":     { "$type": "color", "$value": "{color.purple.60}",    "$description": "Visited hyperlink" }
  }
}
