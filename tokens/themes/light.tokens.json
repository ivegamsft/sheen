{
  "$description": "Light theme — overrides semantic colour $values for light-mode surfaces. Must NOT introduce new semantic keys. All pairs must pass WCAG 2.2 AA (4.5:1 text / 3:1 large+non-text).",
  "color": {
    "background":       { "$type": "color", "$value": "#ffffff" },
    "foreground":       { "$type": "color", "$value": "#1f2328" },
    "muted":            { "$type": "color", "$value": "#57606a" },
    "surface":          { "$type": "color", "$value": "#ffffff" },
    "surface-raised":   { "$type": "color", "$value": "#f6f8fa" },
    "border":           { "$type": "color", "$value": "#d0d7de" },
    "border-muted":     { "$type": "color", "$value": "#eaeef2" },
    "focus-ring":       { "$type": "color", "$value": "#0969da" },
    "primary":          { "$type": "color", "$value": "#0969da" },
    "on-primary":       { "$type": "color", "$value": "#ffffff" },
    "primary-hover":    { "$type": "color", "$value": "#0550ae" },
    "primary-pressed":  { "$type": "color", "$value": "#033d8b" },
    "primary-selected": { "$type": "color", "$value": "#0550ae" },
    "primary-disabled": { "$type": "color", "$value": "#d0d7de" },
    "primary-focus":    { "$type": "color", "$value": "#0969da" },
    "secondary":        { "$type": "color", "$value": "#f6f8fa" },
    "on-secondary":     { "$type": "color", "$value": "#1f2328" },
    "success":          { "$type": "color", "$value": "#1a7f37" },
    "on-success":       { "$type": "color", "$value": "#ffffff" },
    "success-subtle":   { "$type": "color", "$value": "#dafbe1" },
    "warning":          { "$type": "color", "$value": "#9a6700" },
    "on-warning":       { "$type": "color", "$value": "#ffffff" },
    "warning-subtle":   { "$type": "color", "$value": "#fff8c5" },
    "error":            { "$type": "color", "$value": "#cf222e" },
    "on-error":         { "$type": "color", "$value": "#ffffff" },
    "error-subtle":     { "$type": "color", "$value": "#ffebe9" },
    "accent":           { "$type": "color", "$value": "#6e40c9" },
    "on-accent":        { "$type": "color", "$value": "#ffffff" },
    "link":             { "$type": "color", "$value": "#0969da" },
    "link-hover":       { "$type": "color", "$value": "#0550ae" },
    "link-visited":     { "$type": "color", "$value": "#6e40c9" }
  }
}
