{
  "$description": "Dark theme — overrides semantic colour $values for dark-mode surfaces. All pairs must pass WCAG 2.2 AA (4.5:1 text / 3:1 large+non-text).",
  "color": {
    "background":       { "$type": "color", "$value": "#0d1117" },
    "foreground":       { "$type": "color", "$value": "#e6edf3" },
    "muted":            { "$type": "color", "$value": "#8b949e" },
    "surface":          { "$type": "color", "$value": "#161b22" },
    "surface-raised":   { "$type": "color", "$value": "#21262d" },
    "border":           { "$type": "color", "$value": "#30363d" },
    "border-muted":     { "$type": "color", "$value": "#21262d" },
    "focus-ring":       { "$type": "color", "$value": "#2f81f7" },
    "primary":          { "$type": "color", "$value": "#2f81f7" },
    "on-primary":       { "$type": "color", "$value": "#0d1117" },
    "primary-hover":    { "$type": "color", "$value": "#58a6ff" },
    "primary-pressed":  { "$type": "color", "$value": "#79c0ff" },
    "primary-selected": { "$type": "color", "$value": "#58a6ff" },
    "primary-disabled": { "$type": "color", "$value": "#30363d" },
    "primary-focus":    { "$type": "color", "$value": "#2f81f7" },
    "secondary":        { "$type": "color", "$value": "#21262d" },
    "on-secondary":     { "$type": "color", "$value": "#e6edf3" },
    "success":          { "$type": "color", "$value": "#3fb950" },
    "on-success":       { "$type": "color", "$value": "#0d1117" },
    "success-subtle":   { "$type": "color", "$value": "#0f2d1a" },
    "warning":          { "$type": "color", "$value": "#d29922" },
    "on-warning":       { "$type": "color", "$value": "#0d1117" },
    "warning-subtle":   { "$type": "color", "$value": "#2d1f00" },
    "error":            { "$type": "color", "$value": "#f85149" },
    "on-error":         { "$type": "color", "$value": "#0d1117" },
    "error-subtle":     { "$type": "color", "$value": "#2d0f0e" },
    "accent":           { "$type": "color", "$value": "#bc80ff" },
    "on-accent":        { "$type": "color", "$value": "#0d1117" },
    "link":             { "$type": "color", "$value": "#2f81f7" },
    "link-hover":       { "$type": "color", "$value": "#58a6ff" },
    "link-visited":     { "$type": "color", "$value": "#bc80ff" }
  }
}
