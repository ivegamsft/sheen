{
  "$description": "High-contrast theme — WCAG enhanced contrast (>=7:1 for text, >=4.5:1 non-text). Black canvas, white text, cyan primary, yellow highlight. Validated by scripts/validate-tokens.",
  "color": {
    "background":       { "$type": "color", "$value": "#000000" },
    "foreground":       { "$type": "color", "$value": "#ffffff" },
    "muted":            { "$type": "color", "$value": "#e0e0e0" },
    "surface":          { "$type": "color", "$value": "#000000" },
    "surface-raised":   { "$type": "color", "$value": "#1a1a1a" },
    "border":           { "$type": "color", "$value": "#ffffff" },
    "border-muted":     { "$type": "color", "$value": "#c0c0c0" },
    "focus-ring":       { "$type": "color", "$value": "#ffff00" },
    "primary":          { "$type": "color", "$value": "#1aebff" },
    "on-primary":       { "$type": "color", "$value": "#000000" },
    "primary-hover":    { "$type": "color", "$value": "#ffffff" },
    "primary-pressed":  { "$type": "color", "$value": "#e0e0e0" },
    "primary-selected": { "$type": "color", "$value": "#ffff00" },
    "primary-disabled": { "$type": "color", "$value": "#606060" },
    "primary-focus":    { "$type": "color", "$value": "#ffff00" },
    "secondary":        { "$type": "color", "$value": "#1a1a1a" },
    "on-secondary":     { "$type": "color", "$value": "#ffffff" },
    "success":          { "$type": "color", "$value": "#00ff00" },
    "on-success":       { "$type": "color", "$value": "#000000" },
    "success-subtle":   { "$type": "color", "$value": "#001a00" },
    "warning":          { "$type": "color", "$value": "#ffff00" },
    "on-warning":       { "$type": "color", "$value": "#000000" },
    "warning-subtle":   { "$type": "color", "$value": "#1a1a00" },
    "error":            { "$type": "color", "$value": "#ff6666" },
    "on-error":         { "$type": "color", "$value": "#000000" },
    "error-subtle":     { "$type": "color", "$value": "#1a0000" },
    "accent":           { "$type": "color", "$value": "#ffff00" },
    "on-accent":        { "$type": "color", "$value": "#000000" },
    "link":             { "$type": "color", "$value": "#1aebff" },
    "link-hover":       { "$type": "color", "$value": "#ffffff" },
    "link-visited":     { "$type": "color", "$value": "#ff9dff" }
  }
  ,
  "type": {
    "$description": "Typography role tokens — theme override layer. Values identical to semantic; included for completeness.",
    "display":    { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.semibold}", "fontSize": "{type.font-size.5xl}",  "lineHeight": "{type.line-height.tight}",   "letterSpacing": "{type.letter-spacing.tight}"  } },
    "heading-1":  { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.semibold}", "fontSize": "{type.font-size.4xl}",  "lineHeight": "{type.line-height.tight}",   "letterSpacing": "{type.letter-spacing.tight}"  } },
    "heading-2":  { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.semibold}", "fontSize": "{type.font-size.3xl}",  "lineHeight": "{type.line-height.snug}",    "letterSpacing": "{type.letter-spacing.tight}"  } },
    "heading-3":  { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.semibold}", "fontSize": "{type.font-size.2xl}",  "lineHeight": "{type.line-height.snug}",    "letterSpacing": "{type.letter-spacing.normal}" } },
    "body":       { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.regular}",  "fontSize": "{type.font-size.lg}",   "lineHeight": "{type.line-height.normal}",  "letterSpacing": "{type.letter-spacing.normal}" } },
    "body-sm":    { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.regular}",  "fontSize": "{type.font-size.md}",   "lineHeight": "{type.line-height.normal}",  "letterSpacing": "{type.letter-spacing.normal}" } },
    "label":      { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.medium}",   "fontSize": "{type.font-size.md}",   "lineHeight": "{type.line-height.snug}",    "letterSpacing": "{type.letter-spacing.normal}" } },
    "caption":    { "$type": "typography", "$value": { "fontFamily": "{type.font-family.sans}", "fontWeight": "{type.font-weight.regular}",  "fontSize": "{type.font-size.sm}",   "lineHeight": "{type.line-height.normal}",  "letterSpacing": "{type.letter-spacing.normal}" } },
    "code":       { "$type": "typography", "$value": { "fontFamily": "{type.font-family.mono}", "fontWeight": "{type.font-weight.regular}",  "fontSize": "{type.font-size.md}",   "lineHeight": "{type.line-height.relaxed}", "letterSpacing": "{type.letter-spacing.normal}" } },
    "code-sm":    { "$type": "typography", "$value": { "fontFamily": "{type.font-family.mono}", "fontWeight": "{type.font-weight.regular}",  "fontSize": "{type.font-size.sm}",   "lineHeight": "{type.line-height.relaxed}", "letterSpacing": "{type.letter-spacing.normal}" } }
  }
}
